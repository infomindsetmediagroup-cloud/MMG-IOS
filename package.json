{
  "name": "mmg-kairos-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:webllm": "esbuild web/kairos-dashboard/vendor/webllm-entry.js --bundle --format=esm --platform=browser --target=safari18 --alias:url=./web/kairos-dashboard/vendor/node-url-browser-shim.js --outfile=web/kairos-dashboard/vendor/webllm-bundle.js && node scripts/validate-webllm-browser-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:commerce-staging": "tsc -p tsconfig.commerce-staging.json --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run --reporter=verbose backend-tests/kairos-governance-effectiveness-verification.test.ts backend-tests/kairos-governance-remediation-dashboard.test.ts backend-tests/kairos-governance-remediation-planning.test.ts backend-tests/kairos-governance-assurance-planning-dashboard.test.ts backend-tests/kairos-governance-assurance-planning.test.ts backend-tests/kairos-governance-portfolio-dashboard.test.ts backend-tests/kairos-governance-portfolio-oversight.test.ts backend-tests/kairos-governance-obligation-dashboard.test.ts backend-tests/kairos-governance-obligation-tracking.test.ts backend-tests/kairos-policy-exception-dashboard.test.ts backend-tests/kairos-policy-exception-governance.test.ts backend-tests/kairos-continuous-operational-review-dashboard.test.ts backend-tests/kairos-continuous-operational-review.test.ts backend-tests/kairos-operational-continuity-dashboard.test.ts backend-tests/kairos-operational-continuity.test.ts backend-tests/kairos-post-launch-assurance-dashboard.test.ts backend-tests/kairos-post-launch-assurance.test.ts backend-tests/kairos-launch-governance-dashboard.test.ts backend-tests/kairos-controlled-launch-governance.test.ts backend-tests/kairos-readiness-dashboard.test.ts backend-tests/kairos-production-readiness-certification.test.ts backend-tests/kairos-release-operations.test.ts backend-tests/kairos-release-dashboard.test.ts backend-tests/kairos-incident-operations.test.ts backend-tests/kairos-incident-dashboard.test.ts backend-tests/kairos-observability-store.test.ts backend-tests/kairos-observability-runtime.test.ts backend-tests/kairos-operations-health-metrics.test.ts backend-tests/kairos-operations-dashboard.test.ts backend-tests/kairos-contracts.test.ts backend-tests/kairos-api-runtime.test.ts backend-tests/kairos-api-governance.test.ts backend-tests/kairos-dashboard-api-integration.test.ts backend-tests/kairos-context-orchestrator.test.ts backend-tests/kairos-knowledge-lifecycle.test.ts backend-tests/kairos-dashboard-evidence-trace.test.ts backend-tests/kairos-dashboard-operator-controls.test.ts backend-tests/kairos-tool-approval.test.ts backend-tests/kairos-tool-arguments-executors.test.ts backend-tests/kairos-tool-objective-integration.test.ts backend-tests/kairos-shopify-product-read.test.ts backend-tests/kairos-shopify-product-update.test.ts backend-tests/kairos-shopify-product-publish.test.ts backend-tests/kairos-shopify-production-readiness.test.ts",
    "test:manuscript-ui": "playwright test browser-tests/manuscript-project-setup.spec.mjs browser-tests/manuscript-editorial-workbench.spec.mjs browser-tests/manuscript-auto-pipeline.spec.mjs --project=webkit",
    "validate:shopify": "node scripts/validate-shopify-governance.mjs",
    "validate:kairos-shopify": "node scripts/validate-kairos-shopify-policy.mjs",
    "validate:manuscript-activation": "node scripts/validate-kairos-manuscript-activation.mjs",
    "validate:manuscript-production": "node cloudflare/mmg-ios/scripts/validate-manuscript-production-mode.mjs && node cloudflare/mmg-ios/scripts/validate-manuscript-large-intake.mjs",
    "validate:service-product": "node shopify/products/professional-cover-design-service/validate.mjs",
    "validate:commerce-staging-host": "vitest run backend-tests/mmg-cloudflare-staging-host.test.ts",
    "check": "npm run typecheck && npm test && npm run validate:shopify && npm run validate:kairos-shopify && npm run validate:manuscript-activation && npm run validate:service-product",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.82",
    "pg": "^8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.8.0",
    "vitest": "3.2.0",
    "wrangler": "^4.112.0"
  }
}
